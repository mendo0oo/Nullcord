{
    "name": "@nullcord/installer-ui",
    "version": "0.3.0",
    "description": "White and gray desktop installer for NullCord",
    "author": "NullCord contributors",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "test": "tsc --noEmit && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/updater.cjs && node --test tests/updater.test.cjs",
        "dist:win": "pnpm build && electron-builder --win portable --x64"
    },
    "dependencies": {
        "@vitejs/plugin-react": "latest",
        "vite": "latest",
        "typescript": "^6.0.3",
        "react": "19.1.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@types/react": "19.1.0",
        "@types/react-dom": "19.1.0",
        "electron": "latest",
        "electron-builder": "latest"
    },
    "build": {
        "appId": "dev.nullcord.installer",
        "productName": "NullCord Installer",
        "artifactName": "NullCordInstaller.${ext}",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../../NullCordInstallerCli.exe",
                "to": "bin/NullCordInstallerCli.exe"
            }
        ],
        "win": {
            "target": "portable",
            "icon": "../../installer/winres/icon.png"
        }
    }
}
